# Chapter 30 of Book 3: every variable this repo's own code and its
# reliable_agents_labs dependency actually read, curated by hand,
# not just an automated scan's raw output. See triage-app's own
# scripts/check_env_example.py for the tool this list was checked
# against.

# Required: config/models.yaml points "answer_model" at Gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash

# Required: this app's own real Postgres connection (see compose.yaml)
DATABASE_URL=postgresql://reorder_app:reorder_app@localhost:5433/reorder_app

# Required: this app's own real Auth0 API resource (chapter 6)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://reorder-app.dev/api

# Optional: only needed to run tests/contract/test_auth_live.py
# AUTH0_TEST_CLIENT_ID=
# AUTH0_TEST_CLIENT_SECRET=

# Optional: only needed for real tracing (chapter 16); omit to run
# with tracing silently disabled
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001
